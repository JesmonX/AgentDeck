{
  "name": "agentdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 scripts/dev.py",
    "web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:core": "cargo test --workspace --exclude agentdeck-desktop",
    "desktop": "python3 scripts/prepare-bundle.py --debug && cd apps/desktop && tauri dev",
    "desktop:build": "python3 scripts/prepare-bundle.py && cd apps/desktop && tauri build",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "echarts": "^6.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
